# <src>                                       <mnt_point>         <type>  <mnt_flags and options>                  <fs_mgr_flags>
system                                        /system             erofs   ro                                       wait,slotselect,logical,first_stage_mount
system                                        /system             ext4    ro                                       wait,slotselect,logical,first_stage_mount
system_ext                                    /system_ext         erofs   ro                                       wait,slotselect,logical,first_stage_mount
product                                       /product            erofs   ro                                       wait,slotselect,logical,first_stage_mount
mi_ext                                        /mnt/vendor/mi_ext  erofs   ro                                       wait,slotselect,logical,first_stage_mount
vendor                                        /vendor             erofs   ro                                       wait,slotselect,logical,first_stage_mount
odm                                           /odm                erofs   ro                                       wait,slotselect,logical,first_stage_mount
vendor_dlkm                                   /vendor_dlkm        erofs   ro                                       wait,slotselect,logical,first_stage_mount
/dev/block/bootdevice/by-name/metadata        /metadata           f2fs    noatime,nosuid,nodev,discard             wait,check,formattable,first_stage_mount
/dev/block/bootdevice/by-name/userdata        /data               f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fscompress  wait,check,formattable,quota,reservedsize=128M,latemount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/boot            /boot               emmc    defaults                                 slotselect
/dev/block/bootdevice/by-name/misc            /misc               emmc    defaults                                 defaults
/dev/block/bootdevice/by-name/rescue          /cache              ext4    noatime,nosuid,nodev,discard             wait,check